# Threads (Meta) API
THREADS_ACCESS_TOKEN=your_long_lived_access_token
PROACTIVE_PERMISSION_PROBE=false
THREADS_USER_ID=your_threads_user_id
THREADS_USERNAME=leoakastel
THREADS_VERIFY_TOKEN=any_random_string_you_pick_for_webhook_handshake

# Airtable
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_base_id

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000

# Vision v9.2 (safe defaults)
VISION_ENABLED=false
VISION_DETAIL=low
VISION_SHORT_TEXT_THRESHOLD=24
VISION_METADATA_TIMEOUT_MS=12000

# Proactive Copilot discovery (read-only milestone; disabled by default)
PROACTIVE_ENABLED=false
PROACTIVE_MODE=OFF
PROACTIVE_POLL_INTERVAL_SECONDS=900
PROACTIVE_CANDIDATE_TTL_HOURS=72
PROACTIVE_MAX_POST_AGE_MINUTES=720
PROACTIVE_DEFAULT_LIMIT=25
PROACTIVE_REDIS_NAMESPACE=astel:proactive:v1

# Redis safety state
REDIS_URL=redis://redis.internal:6379
REDIS_REQUIRED=true

# v9.1 policy
NORMAL_REPLY_LIMIT=3
COOLDOWN_SECONDS=20
CONVERSATION_RESET_HOURS=24
GLOBAL_DAILY_LIMIT=50
CLOSING_ENABLED=true
CLOSING_AT_REPLY=3
PARENT_LOOKUP_ENABLED=true

# Runtime
BOT_ENABLED=false
BOT_DRY_RUN=true
PORT=3000
